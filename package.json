{
  "name": "dsh-browser-stride",
  "version": "0.1.4",
  "description": "DSH Stride (寻行): product branch of the dsh browser bridge and controlled-tab Chrome/Firefox extension workspace",
  "author": "Yuxiang Lin",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm --filter @yuxianglin/dsh-bridge-browser run build && pnpm --filter dsh-browser-extension run build",
    "start": "dsh web",
    "test": "pnpm --filter @yuxianglin/dsh-bridge-browser run test && pnpm --filter dsh-browser-extension run test && node --test \"scripts/tests/*.test.mjs\"",
    "typecheck": "pnpm --filter @yuxianglin/dsh-bridge-browser run typecheck && pnpm --filter dsh-browser-extension run typecheck",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:publication": "node scripts/check-publication-history.mjs",
    "test:smoke": "node scripts/smoke-runtime.mjs",
    "test:smoke-browser": "node scripts/smoke-browser.mjs",
    "test:benchmark": "node --test \"benchmark/tests/*.test.mjs\"",
    "stride:baseline": "node scripts/stride-baseline.mjs",
    "pair:browser": "node scripts/pair-browser.mjs",
    "stride:baseline:json": "node scripts/stride-baseline.mjs --json --no-write"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
