{
  "name": "dsh-browser-stride",
  "version": "0.1.33",
  "description": "DSH Stride (寻行): product branch of the dsh browser bridge and controlled-tab Chrome/Firefox extension workspace",
  "author": "Yuxiang Lin",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm --filter @eilyeee/dsh-browser-stride run build && pnpm --filter dsh-browser-extension run build",
    "start": "dsh web",
    "test": "pnpm --filter @eilyeee/dsh-browser-stride run test && pnpm --filter dsh-browser-extension run test && node --test \"scripts/tests/*.test.mjs\"",
    "typecheck": "pnpm --filter @eilyeee/dsh-browser-stride run typecheck && pnpm --filter dsh-browser-extension run typecheck",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:publication": "node scripts/check-publication-history.mjs",
    "test:smoke": "node scripts/smoke-runtime.mjs",
    "test:smoke-browser": "node scripts/smoke-browser.mjs",
    "test:benchmark": "node --test \"benchmark/tests/*.test.mjs\"",
    "stride:baseline": "node scripts/stride-baseline.mjs",
    "pair:browser": "node scripts/pair-browser.mjs",
    "stride:baseline:json": "node scripts/stride-baseline.mjs --json --no-write",
    "test:smoke-task": "node scripts/smoke-browser-task.mjs",
    "test:smoke-task-page-ownership": "node scripts/smoke-task-page-ownership.mjs",
    "test:smoke-auto-tab-model": "node scripts/smoke-auto-tab-model.mjs",
    "test:smoke-page-access": "node scripts/smoke-page-access.mjs",
    "test:smoke-layout": "node scripts/smoke-layout.mjs",
    "test:smoke-materials": "node scripts/smoke-materials.mjs",
    "test:smoke-widgets": "node scripts/smoke-widgets.mjs",
    "release:prepare": "pnpm run build && node scripts/package-release.mjs",
    "test:smoke-session": "node scripts/smoke-session-continuity.mjs",
    "test:smoke-operation-feedback": "node scripts/smoke-operation-feedback.mjs",
    "test:smoke-session-failures": "node scripts/smoke-session-continuity.mjs --failures-only",
    "test:smoke-release": "node scripts/smoke-release.mjs",
    "test:smoke-preflight": "node scripts/smoke-preflight-feedback.mjs",
    "test:smoke-write-boundaries": "node scripts/smoke-write-boundaries.mjs",
    "test:smoke-field-readback": "node scripts/smoke-field-readback.mjs",
    "test:smoke-readonly": "node scripts/smoke-field-readback.mjs --readonly-only",
    "test:smoke-editor": "node scripts/smoke-field-readback.mjs --editor-only",
    "test:smoke-scroll": "node scripts/smoke-scroll.mjs",
    "test:smoke-shadow": "node scripts/smoke-shadow-controls.mjs",
    "test:smoke-component-reads": "node scripts/smoke-component-reads.mjs",
    "test:smoke-component-settle": "node scripts/smoke-component-reads.mjs --settle-only",
    "test:smoke-diagnostics": "node scripts/smoke-diagnostics.mjs",
    "test:smoke-diagnostics-status": "node scripts/smoke-diagnostics.mjs --status-race",
    "test:smoke-worker-view": "node scripts/smoke-worker-view.mjs",
    "test:smoke-recovery": "node scripts/smoke-recovery.mjs",
    "test:smoke-snapshot-base": "node scripts/smoke-component-reads.mjs --snapshot-base-only",
    "test:smoke-development": "node scripts/smoke-development.mjs",
    "test:smoke-observation": "node scripts/smoke-observation.mjs",
    "test:smoke-upgrade": "node scripts/smoke-upgrade.mjs",
    "test:smoke-page-authorization": "node scripts/smoke-page-authorization.mjs",
    "test:smoke-audit-target": "node scripts/smoke-audit-target.mjs",
    "test:smoke-task-progress": "node scripts/smoke-task-progress.mjs",
    "test:smoke-control-state": "node scripts/smoke-control-state.mjs",
    "test:smoke-session-selection": "node scripts/smoke-session-selection.mjs",
    "test:smoke-panel-reconnect": "node scripts/smoke-session-selection.mjs --reconnect",
    "test:smoke-binding-status": "node scripts/smoke-binding-status.mjs",
    "test:smoke-selection-feedback": "node scripts/smoke-session-selection.mjs --drop-selection-reply",
    "test:smoke-diagnostics-expiry": "node scripts/smoke-diagnostics.mjs --start-expiry"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.5",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.5",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.5",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.5",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.5",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.5",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.5",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.5",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent-fork-in-process": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-rc.5"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
